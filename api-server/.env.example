DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://192.168.0.152:3000

# print-server (impresora de cocina) corre como servicio hermano en el mismo
# docker-compose.yml — el default de abajo (nombre del servicio, red interna
# de Docker) ya es correcto tal cual, no hace falta tocarlo ni exponerlo por
# ningún túnel (la comunicación api-server → print-server nunca sale a
# internet). Solo cámbialo si print-server llegara a correr fuera de este
# mismo stack de Docker Compose.
PRINT_SERVER_URL=http://print-server:3001
