# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/print-server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pnpm auto-scaffolds this locally on newer pnpm versions when build scripts
# aren't approved yet; the Docker build pins pnpm@9.12.0, which doesn't
# understand this file and hard-fails if it merely exists without a
# `packages:` field. Keep it out of git entirely.
pnpm-workspace.yaml
